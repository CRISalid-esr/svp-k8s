#!/bin/bash


INST=$1
LOCATION=europe-west9
ZONE=europe-west9-a

APP_ENV=DEV
PWD=$(pwd)
INST_DIRECTORY=$PWD/inst/$INST
HELM_CONFIG_DIRECTORY=$PWD/core/helm
CORE_DIRECTORY=$PWD/core
ACCESS_DIRECTORY=$PWD/access
RABBIT_DIRECTORY=$CORE_DIRECTORY/rabbitmq
REDIS_DIRECTORY=$CORE_DIRECTORY/redis
VOC_PROXIES_DIRECTORY=$CORE_DIRECTORY/voc-proxies
DAGS_DIRECTORY=$INST_DIRECTORY/dags

INST_SERVICE_ACCOUNT=$INST-service-account
K8S_SERVICE_ACCOUNT=k8s-service-account

DB_INSTANCE_NAME=crisalid-$INST-db

COMPOSER_ENV_NAME="composer-environment-$INST"

NEO4J_INSTANCE_NAME="neo4j-$INST"
NEO4J_PORT=7687

DATA_BUCKET_NAME="crisalid-$INST-data"
DAGS_BUCKET_NAME="crisalid-$INST-dags"
NEO4J_BACKUP_BUCKET_NAME="crisalid-$INST-neo4j-backup"
TRAINING_DATA_BUCKET_NAME="crisalid-$INST-training-data"
CTD_ES_PORT=9200

KEYCLOAK_INSTANCE_NAME="keycloak-$INST"